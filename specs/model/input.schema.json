{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Astra public model context v1",
  "description": "Only server-authorized public material and the caller's code; schema cannot establish provenance or authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "public_problem", "public_samples", "student_code", "language_key", "sanitized_diagnostic", "verdict", "question"],
  "properties": {
    "schema_version": {"const": "1"},
    "public_problem": {"type": "string", "minLength": 1, "maxLength": 24576},
    "public_samples": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["input", "output"], "properties": {"input": {"type": "string", "maxLength": 4096}, "output": {"type": "string", "maxLength": 4096}}}},
    "student_code": {"type": "string", "minLength": 1, "maxLength": 24576, "pattern": "\\S"},
    "language_key": {"enum": ["cpp17", "python3"]},
    "sanitized_diagnostic": {"type": "string", "maxLength": 8192},
    "verdict": {"enum": ["CE", "WA", "TLE", "RE"]},
    "question": {"type": "string", "maxLength": 500}
  }
}

# Copy values into the deployment environment; the application does not auto-load this file.
# Never commit real database URLs or secrets.
ASTRA_DATABASE_URL=
ASTRA_SESSION_SECRET=
ASTRA_ORIGIN=https://localhost:4175
ASTRA_READINESS_TOKEN=
# Optional UTF-8 JSON list of approved runtime profiles matching the Profile API schema.
# Max 100 profiles / 1 MiB; empty keeps profile selection unavailable.
ASTRA_PROFILES_FILE=
